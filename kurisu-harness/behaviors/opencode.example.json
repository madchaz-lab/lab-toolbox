{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "buffer": 41072,
    "keep": {
      "tokens": 8000
    }
  },
  "model": "glimmer-db04/glimmer-30b",
  "providers": {
    "glimmer-db01": {
      "models": {
        "glimmer-30b": {
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "modelID": "/models/Muse-Glimmer-30B-KQuant-17GB-Q4_K_M.gguf",
          "name": "Muse Glimmer 30B - db01"
        }
      },
      "name": "Glimmer - db01 via MetalLB VIP",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://192.168.33.206:10021/v1"
      }
    },
    "glimmer-db03": {
      "models": {
        "glimmer-30b": {
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "modelID": "/models/Muse-Glimmer-30B-KQuant-17GB-Q4_K_M.gguf",
          "name": "Muse Glimmer 30B - db03"
        }
      },
      "name": "Glimmer - db03 via MetalLB VIP",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://192.168.33.206:10023/v1"
      }
    },
    "glimmer-db04": {
      "models": {
        "glimmer-30b": {
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "modelID": "/models/Muse-Glimmer-30B-KQuant-17GB-Q4_K_M.gguf",
          "name": "Muse Glimmer 30B - db04"
        }
      },
      "name": "Glimmer - db04 via MetalLB VIP",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://192.168.33.206:10024/v1"
      }
    }
  },
  "mcp": {
    "hindsight": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:HINDSIGHT_TENANT_KEY}"
      },
      "oauth": false,
      "type": "remote",
      "url": "http://127.0.0.1:8892/mcp/kurisu/"
    },
    "hindsight-researcher": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:HINDSIGHT_TENANT_KEY}"
      },
      "oauth": false,
      "type": "remote",
      "url": "http://127.0.0.1:8892/mcp/kurisu-researcher/"
    },
    "hindsight-programming": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:HINDSIGHT_TENANT_KEY}"
      },
      "oauth": false,
      "type": "remote",
      "url": "http://127.0.0.1:8892/mcp/kurisu-programming/"
    },
    "hindsight-labadmin": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:HINDSIGHT_TENANT_KEY}"
      },
      "oauth": false,
      "type": "remote",
      "url": "http://127.0.0.1:8892/mcp/kurisu-labadmin/"
    },
    "hindsight-conversation": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:HINDSIGHT_TENANT_KEY}"
      },
      "oauth": false,
      "type": "remote",
      "url": "http://127.0.0.1:8892/mcp/kurisu-conversation/"
    },
    "hindsight-quality": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:HINDSIGHT_TENANT_KEY}"
      },
      "oauth": false,
      "type": "remote",
      "url": "http://127.0.0.1:8892/mcp/kurisu-quality/"
    },
    "hindsight-documentation": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:HINDSIGHT_TENANT_KEY}"
      },
      "oauth": false,
      "type": "remote",
      "url": "http://127.0.0.1:8892/mcp/kurisu-documentation/"
    },
    "hindsight-security": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:HINDSIGHT_TENANT_KEY}"
      },
      "oauth": false,
      "type": "remote",
      "url": "http://127.0.0.1:8892/mcp/kurisu-security/"
    },
    "hindsight-chronoa": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:HINDSIGHT_TENANT_KEY}"
      },
      "oauth": false,
      "type": "remote",
      "url": "http://127.0.0.1:8892/mcp/chronoa-singlebank/"
    },
    "kubernetes": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "kubernetes-mcp-server@latest"
      ],
      "environment": {
        "KUBECONFIG": "/home/makise-kurisu/.kube/config"
      }
    },
    "ssh-mcp": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "ssh-mcp"
      ]
    },
    "todo": {
      "type": "remote",
      "url": "http://kurisu-todo.brains-containment.svc.cluster.local:8001/mcp",
      "enabled": true,
      "headers": {
        "X-Orchestrator-Token": "CHANGE_ME"
      }
    },
    "mail": {
      "type": "remote",
      "url": "http://kurisu-mail.brains-containment.svc.cluster.local:8002/mcp",
      "enabled": true
    }
  },
  "agents": {
    "orchestrator": {
      "mode": "primary",
      "model": "glimmer-db04/glimmer-30b",
      "variant": "medium",
      "description": "Kurisu herself - the lab orchestrator. Runs the loop: board, dispatch, verify, dual-write close.",
      "system": "{file:./agents/orchestrator.md}",
      "permissions": [
        {
          "action": "kubernetes_*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "ssh-mcp_*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "ssh_*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "hindsight_clear_memories",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "hindsight_delete_bank",
