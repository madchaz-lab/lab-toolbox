# Credential / secret safety — never commit these.
# API keys, tokens, passwords, private keys, and configs that embed secrets.
# (Specific patterns on purpose: do NOT ignore *.txt, that would hide requirements.txt.)
cred*.txt
HA_KEY.txt
*apikey*
*token*
*secret*
*.internal_opencode_apikey.txt
*.key
*.pem
*.keyring
id_ed25519
id_rsa

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# OS / editor noise
.DS_Store
*.swp
*~
