# .env.example — memory-mcp tunables (copy to .env beside docker-compose.yml).
# No secrets live here. All values are optional; compose falls back to these
# defaults when .env is absent.

# Host-side ports (container ports are fixed: 8765 MCP, 8200 viewer).
HOST_MCP_PORT=8765
HOST_VIEWER_PORT=8200

# Viewer display name shown in the UI sidebar.
APP_TITLE=Basic Memory

# Default basic-memory project the viewer shows.
BM_PROJECT=main

# Optional: push each git snapshot (note history) to a backup remote.
# Example ssh URL with a mounted deploy key: ssh://git@host/repo.git
GIT_REMOTE=